{
  "name": "csat-math-visual",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "tsc -b && node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "check:data": "node scripts/validate-data.mjs",
    "check:visuals": "node scripts/validate-visuals.mjs --complete",
    "collect:visuals": "node scripts/collect-visuals.mjs --complete"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "lucide-react": "0.468.0",
    "katex": "0.16.22"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@types/katex": "0.16.7",
    "@vitejs/plugin-react": "4.7.0",
    "@tailwindcss/vite": "4.1.13",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "6.4.5"
  }
}
